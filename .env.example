# AgriConnect Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Local: mongodb://127.0.0.1:27017/agriconnect
# Remote (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/agriconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect

# Authentication & JWT Security
JWT_SECRET=your_generated_random_jwt_secret_here

# Frontend Client URL
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
