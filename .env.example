# =================================================================
# AGRICONNECT PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES
# =================================================================

# -----------------------------------------------------------------
# 1. RENDER (BACKEND WEB SERVICE) ENVIRONMENT VARIABLES:
# Add these in: Render Dashboard -> Your Service -> Environment
# -----------------------------------------------------------------
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection String
# e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# JWT Token Secret (Long secure random string)
JWT_SECRET=ebfe057e918e3e5776ee3730ca76c573db7af63e4d9a82f166f6edd3b020dbf9

# Frontend Vercel App URL (Allowed for CORS)
# e.g. https://your-project.vercel.app
CLIENT_URL=https://your-agriconnect.vercel.app

# Web3Forms Key & Admin Notifications
ADMIN_EMAIL=bikramdevsaw9@gmail.com
WEB3FORMS_ACCESS_KEY=36721ff9-419a-4a6a-8f4d-77c17f6ddf52

# Optional SMTP (For direct nodemailer alerts if Google App Password is created)
EMAIL_SERVICE=gmail
EMAIL_USER=bikramdevsaw9@gmail.com
EMAIL_PASS=
EMAIL_FROM="AgriConnect Directorate" <bikramdevsaw9@gmail.com>

# -----------------------------------------------------------------
# 2. VERCEL (FRONTEND) ENVIRONMENT VARIABLES:
# Add these in: Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# -----------------------------------------------------------------
# Backend API Base URL hosted on Render (Include /api or origin URL)
# e.g. https://agriconnect-api.onrender.com/api
VITE_API_URL=https://agriconnect-api.onrender.com/api

# Web3Forms Public Key for Contact Forms
VITE_WEB3FORMS_KEY=36721ff9-419a-4a6a-8f4d-77c17f6ddf52
